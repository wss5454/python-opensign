# true  = use SQLite (local wallacesign.db)
# false = use MySQL server
WALLACESIGN_USE_SQLITE=true

# Admin login credentials
WALLACESIGN_ADMIN_NAME=Admin
WALLACESIGN_ADMIN_EMAIL=admin@wallacesign.local
WALLACESIGN_ADMIN_PASSWORD=admin123

# SQLite file path (only used when WALLACESIGN_USE_SQLITE=true)
# WALLACESIGN_SQLITE_PATH=D:/Jacky/python-opensign/wallacesign.db

# MySQL settings (only used when WALLACESIGN_USE_SQLITE=false)
WALLACESIGN_MYSQL_HOST=127.0.0.1
WALLACESIGN_MYSQL_PORT=3306
WALLACESIGN_MYSQL_USER=wallacesign
WALLACESIGN_MYSQL_PASSWORD=wallacesign
WALLACESIGN_MYSQL_DATABASE=wallacesign

WALLACESIGN_DEBUG=true
WALLACESIGN_HOST=0.0.0.0
WALLACESIGN_PORT=8000
WALLACESIGN_SECRET_KEY=change-me-in-production-wallacesign-secret
